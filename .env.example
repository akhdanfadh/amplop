# Copy to .env, which git ignores: cp .env.example .env
# Development values only; never reuse them on a deployed server.

# PostgreSQL in compose.yaml. User, password, and database apply only when
# its volume is empty; after changing them, run: docker compose down -v
INBOK_POSTGRES_USER=inbok
INBOK_POSTGRES_PASSWORD=inbok
INBOK_POSTGRES_DB=inbok
INBOK_POSTGRES_PORT=5432
