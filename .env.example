# Copy to .env, which git ignores: cp .env.example .env
# Development values only; never reuse them on a deployed server.

# PostgreSQL in compose.yaml. User, password, and database apply only when
# its volume is empty; after changing them, run: docker compose down -v
INBOK_POSTGRES_USER=inbok
INBOK_POSTGRES_PASSWORD=inbok
INBOK_POSTGRES_DB=inbok
INBOK_POSTGRES_PORT=5432

# Go: inbok migrate. Repeats the values above; change them together. In
# the URL, a password's @ : / ? # characters must be percent-encoded,
# e.g. p@ss becomes p%40ss; INBOK_POSTGRES_PASSWORD takes it as is.
INBOK_DATABASE_URL=postgres://inbok:inbok@127.0.0.1:5432/inbok?sslmode=disable

# Go listener. Keep loopback when a reverse proxy on this host serves HTTPS.
INBOK_HTTP_ADDR=127.0.0.1:8080

# Trusted reverse proxies: comma-separated network ranges (CIDRs), e.g.
# 127.0.0.1/32,::1/128. Empty ignores forwarded client addresses.
# For same-host nginx connecting over IPv4, use 127.0.0.1/32 only.
# backend/README.md has the proxy example; session lifetimes are not settings.
INBOK_TRUSTED_PROXIES=

# First administrator: leave empty to disable setup. Generate a random token
# with openssl rand -base64 32, then paste its output here and restart Go.
# Remove the token after setup and restart Go again.
INBOK_SETUP_TOKEN=

# go tool goose, run from backend, e.g. go tool goose status
GOOSE_DRIVER=postgres
GOOSE_DBSTRING=${INBOK_DATABASE_URL}
GOOSE_MIGRATION_DIR=internal/repository/postgres/migrations
