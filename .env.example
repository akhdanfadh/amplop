# Copy to .env, which git ignores: cp .env.example .env
# Development values only; never reuse them on a deployed server.

# PostgreSQL in compose.yaml. User, password, and database apply only when
# its volume is empty; after changing them, run: docker compose down -v
INBOK_POSTGRES_USER=inbok
INBOK_POSTGRES_PASSWORD=inbok
INBOK_POSTGRES_DB=inbok
INBOK_POSTGRES_PORT=5432

# Mailpit in compose.yaml catches system email for local testing;
# backend/README.md lists the settings to enter.
INBOK_MAILPIT_SMTP_PORT=1025
INBOK_MAILPIT_WEB_PORT=8025

# Meilisearch in compose.yaml, the search index. Its web dashboard at
# http://localhost:7700 asks for the key. Serve and the worker read the
# key too.
INBOK_MEILISEARCH_PORT=7700
INBOK_MEILISEARCH_KEY=inbok-development-key

# SeaweedFS in compose.yaml holds message content; its port is on this
# machine only.
INBOK_SEAWEEDFS_PORT=8333

# Go: inbok migrate. Repeats the values above; change them together. In
# the URL, a password's @ : / ? # characters must be percent-encoded,
# e.g. p@ss becomes p%40ss; INBOK_POSTGRES_PASSWORD takes it as is.
INBOK_DATABASE_URL=postgres://inbok:inbok@127.0.0.1:5432/inbok?sslmode=disable

# Go: serve and the worker. Repeats INBOK_MEILISEARCH_PORT; change them
# together.
INBOK_MEILISEARCH_URL=http://127.0.0.1:7700

# Go: serve and the worker keep message content in SeaweedFS, signing in
# with these keys. The endpoint repeats INBOK_SEAWEEDFS_PORT; change them
# together. SeaweedFS takes the keys on every start, so after changing
# them, make services-start replaces the old ones and keeps the content.
INBOK_S3_ENDPOINT=http://127.0.0.1:8333
INBOK_S3_ACCESS_KEY_ID=inbok
INBOK_S3_SECRET_ACCESS_KEY=inbok-development

# Go listener. Keep loopback when a reverse proxy on this host serves HTTPS.
INBOK_HTTP_ADDR=127.0.0.1:8080
# The worker's health check listener in make dev, which passes it to the
# worker as INBOK_HTTP_ADDR.
INBOK_WORKER_HTTP_ADDR=127.0.0.1:8081

# Required for serve and the worker: the address users open inbok at, e.g.
# https://mail.example.com. Links in inbok's emails start with it, and its
# host is the name inbok gives mail servers. https, or http only for
# localhost and loopback addresses; no path. Locally, the Vite dev server.
INBOK_PUBLIC_URL=http://localhost:5173

# Trusted reverse proxies: comma-separated network ranges (CIDRs), e.g.
# 127.0.0.1/32,::1/128. Empty ignores forwarded client addresses.
# For same-host nginx connecting over IPv4, use 127.0.0.1/32 only.
# backend/README.md has the proxy example; session lifetimes are not settings.
INBOK_TRUSTED_PROXIES=

# Required for serve and the worker: generate a 32-byte key with
# openssl rand -base64 32.
# Paste it after a positive numeric ID, e.g. 1:<output>. No default is generated.
# To rotate, prepend a new ID and key; keep older entries for existing data:
# INBOK_ENCRYPTION_KEYS=2:<new base64 key>,1:<old base64 key>
# Back up keys separately from the database. A lost key breaks authenticator
# codes for its users, the system email password, and connected Gmail
# accounts' refresh tokens; backend/README.md explains rotation and loss.
# Never remove a key while stored data still needs it.
INBOK_ENCRYPTION_KEYS=

# First administrator: leave empty to disable setup. Generate a random token
# with openssl rand -base64 32, then paste its output here and restart Go.
# Remove the token after setup and restart Go again.
INBOK_SETUP_TOKEN=

# Gmail: the Google OAuth client members connect accounts with. These
# values are the development client of the Google emulator in
# compose.yaml (google-emulator/emulate.config.mjs), which runs at
# INBOK_GOOGLE_EMULATOR_PORT; INBOK_GOOGLE_BASE_URL points inbok at it.
# To turn Gmail off, empty all three INBOK_GOOGLE_ settings below. For
# real Gmail, empty INBOK_GOOGLE_BASE_URL and set your own Google client.
INBOK_GOOGLE_EMULATOR_PORT=4000
INBOK_GOOGLE_CLIENT_ID=inbok-dev.apps.googleusercontent.com
INBOK_GOOGLE_CLIENT_SECRET=inbok-dev-secret
# Only localhost or a loopback address; anything else stops startup. The
# emulator takes the same value as its own address, so change the port
# above rather than this line.
INBOK_GOOGLE_BASE_URL=http://127.0.0.1:${INBOK_GOOGLE_EMULATOR_PORT}

# go tool goose, run from backend, e.g. go tool goose status
GOOSE_DRIVER=postgres
GOOSE_DBSTRING=${INBOK_DATABASE_URL}
GOOSE_MIGRATION_DIR=internal/repository/postgres/migrations
