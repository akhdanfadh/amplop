#!/bin/sh
# A fake docker for upgrade.bats. It logs every call to $WORK/all, and each
# call that changes something to $WORK/calls, with the image amplop:local
# points to at that moment. It answers only the questions upgrade.sh should
# ask, exactly as it should ask them, and exits 99 on any other.
#
# A test sets:
# - FAIL, an extended regular expression: a call that matches it fails
#   before it answers or changes anything, but only while amplop:local is
#   FAIL_IMAGE when that is set;
# - VOLUMES, the project's volumes as name=key, one per line;
# - PREVIOUS, the image amplop:local names before the upgrade, empty for a
#   first deploy with none; "previous" when unset;
# - CONFIG, what docker compose config prints; a project named probe when
#   unset.

# Drop --project-directory and its value while they are still separate
# arguments, so a directory with a space in its name goes whole.
skip=
for arg do
	shift
	if [ -n "$skip" ]; then
		skip=
		continue
	fi
	if [ "$arg" = --project-directory ]; then
		skip=1
		continue
	fi
	set -- "$@" "$arg"
done
for last do :; done
args="$*"
image=$(cat "$WORK/image")
echo "$args" >> "$WORK/all"

case $args in
"image inspect"* | "volume ls"* | "volume inspect"* | *" config" | *" config --"*) question=1 ;;
*)
	question=
	echo "${AMPLOP_IMAGE:+AMPLOP_IMAGE=$AMPLOP_IMAGE }[$image] docker $args" >> "$WORK/calls"
	;;
esac

if [ -n "${FAIL:-}" ] && printf '%s' "$args" | grep -E -q -e "$FAIL"; then
	if [ -z "${FAIL_IMAGE:-}" ] || [ "$image" = "$FAIL_IMAGE" ]; then
		exit 1
	fi
fi

if [ -n "$question" ]; then
	case $args in
	"compose -p probe config --services")
		printf 'postgres\nmeilisearch\nseaweedfs\nmigrate\namplop\nworker\ncaddy\n'
		;;
	"compose -p probe config --volumes")
		printf 'db\ncontent\nmeilisearch-1.56.1\n'
		;;
	"compose -p probe config")
		if [ -z "${CONFIG+set}" ]; then
			printf 'name: probe\nservices: {}\n'
		else
			printf '%s\n' "$CONFIG"
		fi
		;;
	"volume ls -q --filter label=com.docker.compose.project=probe")
		printf '%s\n' "${VOLUMES:-}" | sed -n 's/=.*//p'
		;;
	"volume inspect --format {{index .Labels \"com.docker.compose.volume\"}} $last")
		printf '%s\n' "${VOLUMES:-}" | while IFS='=' read -r name key; do
			if [ "$name" = "$last" ]; then
				echo "$key"
			fi
		done
		;;
	"image inspect --format {{.Id}} amplop:local")
		if [ -z "${PREVIOUS-previous}" ]; then
			exit 1
		fi
		echo "${PREVIOUS-previous}"
		;;
	*)
		echo "fake docker: unexpected question: docker $args" >&2
		exit 99
		;;
	esac
	exit 0
fi

case $args in
"tag "*)
	set -- $args
	echo "$2" > "$WORK/image"
	;;
esac
exit 0
