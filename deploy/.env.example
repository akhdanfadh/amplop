# Copy to deploy/.env, which git ignores, and keep it private:
#   cp .env.example .env && chmod 600 .env
# Fill in every empty value before the first docker compose up, apart from
# the optional Gmail settings at the end. These are production settings:
# none of the repository root's development values belong here. A variable
# set in your shell overrides this file, and docker compose config prints
# these values, secrets included.

# The domain inbok answers on, e.g. inbok.example.com. Its DNS must point
# at this machine, with ports 80 and 443 open, so Caddy can get its
# certificate; open 443 for UDP too, for HTTP/3.
INBOK_DOMAIN=

# The address users open inbok at. Links in inbok's emails start with it.
# Change it only if users reach inbok elsewhere, e.g. a trial on
# https://localhost:8443 or your own proxy on another name.
INBOK_PUBLIC_URL=https://${INBOK_DOMAIN}

# PostgreSQL's password. Generate it with: openssl rand -hex 32
# Hex needs no escaping in the connection URL Compose builds from it. It
# applies only when the database volume is first created. To change it
# later, set it in PostgreSQL first, where psql asks for it without echo
# and keeps it out of shell history, then here, then docker compose up -d:
#   docker compose exec postgres psql -U inbok -c '\password inbok'
INBOK_POSTGRES_PASSWORD=

# Keys that encrypt stored secrets. Generate one with:
#   echo "1:$(openssl rand -base64 32)"
# Back it up apart from database backups: a database restore needs every
# key its rows use. To rotate, put a new ID and key first and keep the old
# ones, e.g. 2:<new key>,1:<old key>, then run docker compose up -d. Never
# remove a key while stored data still needs it; backend/README.md explains
# rotation and what a lost key breaks.
INBOK_ENCRYPTION_KEYS=

# One-time token for creating the first administrator. Generate it with:
#   openssl rand -base64 32
# After setup, empty this line and run docker compose up -d again.
INBOK_SETUP_TOKEN=

# Gmail: the Google OAuth client members connect their Gmail accounts
# with, from your own Google Cloud project; README.md's "Connecting Gmail"
# says how to create it. Leave both empty to not offer Gmail. Set both or
# neither: one alone stops inbok at startup.
INBOK_GOOGLE_CLIENT_ID=
INBOK_GOOGLE_CLIENT_SECRET=

# Host ports Caddy listens on. A public certificate needs 80 and 443;
# change them only for a trial on localhost beside other servers.
INBOK_CADDY_HTTP_PORT=80
INBOK_CADDY_HTTPS_PORT=443
