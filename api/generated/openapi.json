{
  "components": {
    "schemas": {
      "FirstAdmin": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "type": "string"
          },
          "id": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "email"
        ],
        "type": "object"
      },
      "HealthStatus": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "enum": [
              "ok"
            ],
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "InputError": {
        "additionalProperties": false,
        "properties": {
          "location": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "location",
          "message"
        ],
        "type": "object"
      },
      "NewProbeEvent": {
        "additionalProperties": false,
        "properties": {
          "amount": {
            "format": "int64",
            "maximum": 10,
            "minimum": 1,
            "type": "integer"
          },
          "highlighted": {
            "type": "boolean"
          },
          "note": {
            "maxLength": 120,
            "pattern": "\\S",
            "patternDescription": "not blank",
            "type": "string"
          },
          "tag": {
            "description": "Omit or null for no tag.",
            "maxLength": 40,
            "minLength": 1,
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "note",
          "amount",
          "highlighted"
        ],
        "type": "object"
      },
      "NewSession": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "format": "email",
            "maxLength": 254,
            "minLength": 3,
            "type": "string"
          },
          "password": {
            "maxLength": 128,
            "type": "string",
            "writeOnly": true
          }
        },
        "required": [
          "email",
          "password"
        ],
        "type": "object"
      },
      "NewSetup": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "format": "email",
            "maxLength": 254,
            "minLength": 3,
            "type": "string"
          },
          "password": {
            "maxLength": 128,
            "minLength": 15,
            "type": "string",
            "writeOnly": true
          },
          "token": {
            "type": "string",
            "writeOnly": true
          }
        },
        "required": [
          "token",
          "email",
          "password"
        ],
        "type": "object"
      },
      "ProbeEvent": {
        "additionalProperties": false,
        "properties": {
          "amount": {
            "format": "int64",
            "type": "integer"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "highlighted": {
            "type": "boolean"
          },
          "id": {
            "format": "int64",
            "type": "integer"
          },
          "note": {
            "type": "string"
          },
          "tag": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "note",
          "amount",
          "highlighted",
          "tag",
          "createdAt"
        ],
        "type": "object"
      },
      "ProbeEventCreated": {
        "additionalProperties": false,
        "properties": {
          "event": {
            "$ref": "#/components/schemas/ProbeEvent"
          },
          "total": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "event",
          "total"
        ],
        "type": "object"
      },
      "Problem": {
        "additionalProperties": false,
        "properties": {
          "detail": {
            "type": "string"
          },
          "errors": {
            "items": {
              "$ref": "#/components/schemas/InputError"
            },
            "minItems": 1,
            "type": "array"
          },
          "instance": {
            "format": "uri-reference",
            "type": "string"
          },
          "status": {
            "format": "int64",
            "maximum": 599,
            "minimum": 100,
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "format": "uri-reference",
            "type": "string"
          }
        },
        "required": [
          "type",
          "status",
          "title",
          "detail"
        ],
        "type": "object"
      },
      "ResponseFirstAdmin": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/components/schemas/FirstAdmin"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "ResponseHealthStatus": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/components/schemas/HealthStatus"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "ResponseProbeEventCreated": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/components/schemas/ProbeEventCreated"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "ResponseSetupStatus": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/components/schemas/SetupStatus"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "ResponseSignInResult": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/components/schemas/SignInResult"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "SetupStatus": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "enum": [
              "unconfigured",
              "open",
              "done"
            ],
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "SignInResult": {
        "additionalProperties": false,
        "properties": {
          "step": {
            "enum": [
              "complete"
            ],
            "type": "string"
          }
        },
        "required": [
          "step"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "description": "## Shared errors\n\nErrors use application/problem+json. The HTTP status describes the broad\nfailure; type identifies the specific problem. The body includes type,\nstatus, title, and detail. Quote the X-Request-ID response header when\nreporting a failure.\n\nEach operation documents its specific failures with examples. Its default\nresponse covers other errors using the same Problem schema, including:\n\n| Status | Meaning |\n| --- | --- |\n| 400 | The request cannot be parsed. |\n| 403 | A write request's source is missing or not allowed. |\n| 404 | The route or resource was not found. |\n| 405 | The route does not support this method; see the Allow header. |\n| 408 | Receiving the request body took too long. |\n| 413 | The request body is too large. |\n| 415 | The request content type is unsupported. |\n| 422 | Parsed input violates the request rules. |\n| 500 | An unexpected server failure occurred. |\n\nBody errors apply to operations that accept a body. A default response\ndescribes the body format, not a replacement HTTP status.\n\nWrite requests require Sec-Fetch-Site or Origin. Command-line clients can\nsend an Origin matching the request's target.\n\nInput errors can include an errors list with field locations and safe\ncorrection messages. For example, a 422 response from POST /setup:\n\n    {\n      \"type\": \"/api/v0/problems/validation-error\",\n      \"status\": 422,\n      \"title\": \"Invalid request\",\n      \"detail\": \"Correct the rejected request inputs.\",\n      \"errors\": [\n        {\"location\": \"body.password\", \"message\": \"Use 15 to 128 characters.\"}\n      ]\n    }\n\nUse the actual HTTP status for request decisions. Handle unfamiliar problem\ntypes by showing their safe detail. An intermediary, such as a proxy, may\nreturn an error without a Problem Details body.\n",
    "title": "inbok",
    "version": "0.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseHealthStatus"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Other errors. See Shared errors in the API overview."
          }
        },
        "summary": "Check process health"
      }
    },
    "/probe/events": {
      "post": {
        "operationId": "createProbeEvent",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewProbeEvent"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseProbeEventCreated"
                }
              }
            },
            "description": "Created"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "example": {
                  "type": "/api/v0/problems/counter-full",
                  "status": 409,
                  "title": "Counter full",
                  "detail": "The counter is full."
                },
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The counter is full."
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Other errors. See Shared errors in the API overview."
          }
        },
        "summary": "Add to the probe counter"
      }
    },
    "/sessions": {
      "post": {
        "operationId": "createSession",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewSession"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseSignInResult"
                }
              }
            },
            "description": "Created",
            "headers": {
              "Set-Cookie": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/problem+json": {
                "example": {
                  "type": "/api/v0/problems/invalid-credentials",
                  "status": 401,
                  "title": "Sign-in failed",
                  "detail": "The email or password is incorrect."
                },
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The email or password is incorrect."
          },
          "429": {
            "content": {
              "application/problem+json": {
                "example": {
                  "type": "/api/v0/problems/sign-in-throttled",
                  "status": 429,
                  "title": "Too many attempts",
                  "detail": "Too many failed attempts. Try again later."
                },
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Too many recent sign-in failures from this address."
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Other errors. See Shared errors in the API overview."
          }
        },
        "summary": "Sign in with a password"
      }
    },
    "/setup": {
      "get": {
        "operationId": "getSetupStatus",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseSetupStatus"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Other errors. See Shared errors in the API overview."
          }
        },
        "summary": "Get first-admin setup status"
      },
      "post": {
        "operationId": "createFirstAdmin",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewSetup"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseFirstAdmin"
                }
              }
            },
            "description": "Created"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "example": {
                  "type": "/api/v0/problems/setup-token-invalid",
                  "status": 403,
                  "title": "Setup token invalid",
                  "detail": "The setup token is invalid."
                },
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The setup token is invalid."
          },
          "409": {
            "content": {
              "application/problem+json": {
                "examples": {
                  "setupDone": {
                    "value": {
                      "type": "/api/v0/problems/setup-done",
                      "status": 409,
                      "title": "Setup complete",
                      "detail": "An administrator has already been created."
                    }
                  },
                  "setupUnconfigured": {
                    "value": {
                      "type": "/api/v0/problems/setup-unconfigured",
                      "status": 409,
                      "title": "Setup unavailable",
                      "detail": "Configure INBOK_SETUP_TOKEN to enable setup."
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Setup is complete or no setup token is configured."
          },
          "429": {
            "content": {
              "application/problem+json": {
                "example": {
                  "type": "/api/v0/problems/sign-in-throttled",
                  "status": 429,
                  "title": "Too many attempts",
                  "detail": "Too many failed attempts. Try again later."
                },
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Too many recent failed attempts from this address."
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Other errors. See Shared errors in the API overview."
          }
        },
        "summary": "Create the first administrator"
      }
    }
  },
  "servers": [
    {
      "url": "/api/v0"
    }
  ]
}
