{
  "components": {
    "schemas": {
      "FirstAdmin": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "type": "string"
          },
          "id": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "email"
        ],
        "type": "object"
      },
      "HealthStatus": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "enum": [
              "ok"
            ],
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "InputError": {
        "additionalProperties": false,
        "properties": {
          "location": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "location",
          "message"
        ],
        "type": "object"
      },
      "NewProbeEvent": {
        "additionalProperties": false,
        "properties": {
          "amount": {
            "format": "int64",
            "maximum": 10,
            "minimum": 1,
            "type": "integer"
          },
          "highlighted": {
            "type": "boolean"
          },
          "note": {
            "maxLength": 120,
            "pattern": "\\S",
            "patternDescription": "not blank",
            "type": "string"
          },
          "tag": {
            "description": "Omit or null for no tag.",
            "maxLength": 40,
            "minLength": 1,
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "note",
          "amount",
          "highlighted"
        ],
        "type": "object"
      },
      "NewSetup": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "format": "email",
            "maxLength": 254,
            "minLength": 3,
            "type": "string"
          },
          "password": {
            "maxLength": 128,
            "minLength": 15,
            "type": "string",
            "writeOnly": true
          },
          "token": {
            "type": "string",
            "writeOnly": true
          }
        },
        "required": [
          "token",
          "email",
          "password"
        ],
        "type": "object"
      },
      "ProbeEvent": {
        "additionalProperties": false,
        "properties": {
          "amount": {
            "format": "int64",
            "type": "integer"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "highlighted": {
            "type": "boolean"
          },
          "id": {
            "format": "int64",
            "type": "integer"
          },
          "note": {
            "type": "string"
          },
          "tag": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "note",
          "amount",
          "highlighted",
          "tag",
          "createdAt"
        ],
        "type": "object"
      },
      "ProbeEventCreated": {
        "additionalProperties": false,
        "properties": {
          "event": {
            "$ref": "#/components/schemas/ProbeEvent"
          },
          "total": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "event",
          "total"
        ],
        "type": "object"
      },
      "Problem": {
        "additionalProperties": false,
        "properties": {
          "detail": {
            "type": "string"
          },
          "errors": {
            "items": {
              "$ref": "#/components/schemas/InputError"
            },
            "minItems": 1,
            "type": "array"
          },
          "instance": {
            "format": "uri-reference",
            "type": "string"
          },
          "status": {
            "format": "int64",
            "maximum": 599,
            "minimum": 100,
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "format": "uri-reference",
            "type": "string"
          }
        },
        "required": [
          "type",
          "status",
          "title",
          "detail"
        ],
        "type": "object"
      },
      "ResponseFirstAdmin": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/components/schemas/FirstAdmin"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "ResponseHealthStatus": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/components/schemas/HealthStatus"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "ResponseProbeEventCreated": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/components/schemas/ProbeEventCreated"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "ResponseSetupStatus": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/components/schemas/SetupStatus"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "SetupStatus": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "enum": [
              "unconfigured",
              "open",
              "done"
            ],
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "title": "inbok",
    "version": "0.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseHealthStatus"
                }
              }
            },
            "description": "OK"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "Check process health"
      }
    },
    "/probe/events": {
      "post": {
        "operationId": "createProbeEvent",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewProbeEvent"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseProbeEventCreated"
                }
              }
            },
            "description": "Created"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Bad Request"
          },
          "408": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Request Timeout"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "example": {
                  "type": "/api/v0/problems/counter-full",
                  "status": 409,
                  "title": "Counter full",
                  "detail": "The counter is full."
                },
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The counter is full."
          },
          "413": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Request Entity Too Large"
          },
          "415": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unsupported Media Type"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "Add to the probe counter"
      }
    },
    "/setup": {
      "get": {
        "operationId": "getSetupStatus",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseSetupStatus"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Get first-admin setup status"
      },
      "post": {
        "operationId": "createFirstAdmin",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewSetup"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseFirstAdmin"
                }
              }
            },
            "description": "Created"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Bad Request"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "example": {
                  "type": "/api/v0/problems/setup-token-invalid",
                  "status": 403,
                  "title": "Setup token invalid",
                  "detail": "The setup token is invalid."
                },
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Forbidden"
          },
          "408": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Request Timeout"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "examples": {
                  "setupDone": {
                    "value": {
                      "type": "/api/v0/problems/setup-done",
                      "status": 409,
                      "title": "Setup complete",
                      "detail": "An administrator has already been created."
                    }
                  },
                  "setupUnconfigured": {
                    "value": {
                      "type": "/api/v0/problems/setup-unconfigured",
                      "status": 409,
                      "title": "Setup unavailable",
                      "detail": "Configure INBOK_SETUP_TOKEN to enable setup."
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Setup is complete or no setup token is configured."
          },
          "413": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Request Entity Too Large"
          },
          "415": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unsupported Media Type"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "Create the first administrator"
      }
    }
  },
  "servers": [
    {
      "url": "/api/v0"
    }
  ]
}
